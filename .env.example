# Copy to .env and adjust. Every setting is also a plain environment variable.

# ── Service ────────────────────────────────────────────────────────────────
AURA_ENVIRONMENT=development
AURA_HOST=0.0.0.0
AURA_PORT=8000
AURA_LOG_LEVEL=INFO
AURA_LOG_JSON=false
# Comma-separated. Narrow this in production.
AURA_CORS_ORIGINS=*

# ── Engine ─────────────────────────────────────────────────────────────────
# auto  — use Gemma 3n when torch/transformers are installed, else echo
# gemma — require Gemma 3n (fails fast if the ML stack is missing)
# echo  — the dependency-free reflective coach, for demos and CI
AURA_ENGINE=auto
AURA_MODEL_ID=unsloth/gemma-3n-E2B-it
# Point at a LoRA adapter produced by `aura train`.
# AURA_ADAPTER_PATH=artifacts/wellness-coach/adapter
AURA_LOAD_IN_4BIT=true
AURA_MAX_NEW_TOKENS=512
AURA_TEMPERATURE=0.7

# ── Modalities ─────────────────────────────────────────────────────────────
AURA_ENABLE_VISION=true
AURA_ENABLE_AUDIO_INPUT=true
AURA_ENABLE_AUDIO_OUTPUT=true
# gemma (native, one model for everything) | whisper | none
AURA_ASR_BACKEND=gemma
# speecht5 | piper | none
AURA_TTS_BACKEND=speecht5
# Prosody-based emotion needs an extra wav2vec2 model; off by default.
AURA_ENABLE_SPEECH_EMOTION=false

# ── Safety ─────────────────────────────────────────────────────────────────
AURA_SAFETY_ENABLED=true
# Which crisis lines to surface first: US | IN | UK | INTL
AURA_CRISIS_REGION=INTL

# ── Sessions ───────────────────────────────────────────────────────────────
AURA_SESSION_TTL_SECONDS=21600
AURA_MAX_TURNS_IN_CONTEXT=12
