{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,notebooks/**,docs/**,.github/**,artifacts/**,var/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "AURA_ENGINE": "echo",
    "AURA_ENVIRONMENT": "production",
    "AURA_LOG_JSON": "true",
    "AURA_TTS_BACKEND": "none",
    "AURA_ASR_BACKEND": "none"
  }
}
